    "#car wear tear \n",
    "def apply_age_wear_adjustment(base_mileage, car_age_years, decay_rate_per_year=0.008, max_decay=0.30):\n",
    "    \"\"\"\n",
    "    Degrades a car's claimed/base mileage based on its current age, to approximate\n",
    "    real-world wear-and-tear (separate from the E20-specific drop).\n",
    "\n",
    "    Parameters:\n",
    "        base_mileage (float): claimed or known mileage on regular petrol (km/L)\n",
    "        car_age_years (float): current age of the car in years (user-entered)\n",
    "        decay_rate_per_year (float): assumed mileage loss per year (default 0.8%)\n",
    "        max_decay (float): cap on total wear-based loss (default 30%)\n",
    "\n",
    "    Returns:\n",
    "        float: wear-adjusted mileage estimate\n",
    "    \"\"\"\n",
    "    if car_age_years < 0:\n",
    "        raise ValueError(\"Car age cannot be negative.\")\n",
    "\n",
    "    decay = min(car_age_years * decay_rate_per_year, max_decay)\n",
    "    return base_mileage * (1 - decay)\n",
    "\n",
    "\n",
    "# Quick test with the Swift Dzire 2011 example discussed earlier\n",
    "claimed_mileage_swift = 19.0   # ARAI claimed mileage, ~2011 Swift Dzire petrol\n",
    "age_years = 2026 - 2011        # 15 years old\n",
    "adjusted = apply_age_wear_adjustment(claimed_mileage_swift, age_years)\n",
    "print(f\"Claimed mileage: {claimed_mileage_swift} km/L\")\n",
    "print(f\"Age: {age_years} years\")\n",
    "print(f\"Wear-adjusted real-world mileage estimate: {adjusted:.2f} km/L\")\n"
   ]
  },
