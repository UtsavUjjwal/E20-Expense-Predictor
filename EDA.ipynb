      "text/plain": [
       "{'brand': 'Maruti Suzuki',\n",
       " 'engine_cc': 1200,\n",
       " 'launch_year': 2022,\n",
       " 'e20_compatible': 'Yes',\n",
       " 'predicted_drop_pct': 4.0,\n",
