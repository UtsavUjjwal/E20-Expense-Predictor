   "source": [
    "# FULL PIPLEIN AG WEAR + E20 + COST (COMBINED)\n",
    "def estimate_monthly_cost_with_age(claimed_mileage, car_age_years, monthly_km, price_per_litre,\n",
    "                                    engine_cc, launch_year, e20_compatible, brand=None,\n",
    "                                    known_current_mileage=None):\n",
    "    \"\"\"\n",
    "    Full pipeline combining:\n",
    "      1. Age-based wear adjustment (user-entered car age) -> realistic current mileage on regular petrol\n",
    "      2. E20-specific drop (ML model) -> mileage on E20\n",
    "      3. Monthly cost comparison\n",
    "\n",
    "    If the user already knows their car's exact current tested mileage, pass it via\n",
    "    `known_current_mileage` to skip the age-based heuristic and use the real number instead.\n",
    "    \"\"\"\n",
    "    if monthly_km <= 0 or price_per_litre <= 0 or claimed_mileage <= 0:\n",
    "        return {\"error\": \"Monthly km, fuel price, and claimed mileage must all be positive numbers.\"}\n",
    "\n",
    "    if known_current_mileage is not None and known_current_mileage > 0:\n",
    "        current_mileage_petrol = known_current_mileage\n",
    "        wear_note = \"Used user-provided actual current mileage (age adjustment skipped).\"\n",
    "    else:\n",
    "        current_mileage_petrol = apply_age_wear_adjustment(claimed_mileage, car_age_years)\n",
    "        wear_note = (f\"Estimated from claimed mileage ({claimed_mileage} km/L) degraded for \"\n",
    "                     f\"{car_age_years} years of age (heuristic, not ML-learned).\")\n",
    "\n",
    "    result = estimate_monthly_cost(\n",
    "        mileage_tested=current_mileage_petrol,\n",
    "        monthly_km=monthly_km,\n",
    "        price_per_litre=price_per_litre,\n",
    "        engine_cc=engine_cc,\n",
    "        launch_year=launch_year,\n",
    "        e20_compatible=e20_compatible,\n",
    "        brand=brand\n",
    "    )\n",
    "\n",
    "    if not result.get(\"error\"):\n",
    "        result[\"wear_adjustment_note\"] = wear_note\n",
    "        result[\"current_mileage_petrol_estimated\"] = round(current_mileage_petrol, 2)\n",
    "\n",
    "    return result\n",
